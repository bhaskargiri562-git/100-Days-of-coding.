#include <stdio.h>

int main() {
    int a, b;

    printf("Enter first numbers: ");
    scanf("%d",&a);

    printf("Enter second number: ");
    scanf("%d",&b);

    a = a + b;  
    b = a - b;  
    a = a - b;  

    printf("After swap: %d %d\n", a, b);

    return 0;
}


